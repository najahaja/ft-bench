{
  "environment": {
    "platform": "Kaggle",
    "gpu": "Tesla T4",
    "gpu_vram_gb": 14.6,
    "cuda_version": "12.8",
    "torch_version": "2.10.0+cu128",
    "python_version": "3.10"
  },
  "vllm_config": {
    "version": "0.4.x",
    "serving_framework": "vLLM + FastAPI",
    "systems": {
      "base": {
        "model": "meta-llama/Llama-3.2-3B-Instruct",
        "dtype": "float16",
        "quantization": null
      },
      "finetuned": {
        "model": "najahaja/ftbench-qlora-llama3.2-3b",
        "dtype": "float16",
        "quantization": null
      },
      "awq": {
        "model": "najahaja/ftbench-qlora-llama3.2-3b-awq",
        "dtype": "float16",
        "quantization": "awq"
      }
    }
  },
  "note": "Benchmark designed for T4 GPU. Full latency/throughput benchmark requires vLLM installation."
}